#!/usr/bin/env bash
# swarm — orchestrate Claude Code lieutenants in tmux windows.
set -euo pipefail

for _d in /opt/homebrew/bin /usr/local/bin; do
  case ":$PATH:" in *":$_d:"*) ;; *) PATH="$PATH:$_d" ;; esac
done
export PATH
unset _d

# Resolve symlinks (macOS has no readlink -f) to find the repo root.
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  _dir=$(cd "$(dirname "$_src")" && pwd)
  _src=$(readlink "$_src")
  [[ "$_src" == /* ]] || _src="$_dir/$_src"
done
SWARM_ROOT=$(cd "$(dirname "$_src")/.." && pwd)
unset _src _dir

for _f in "$SWARM_ROOT"/lib/swarm/*.sh; do
  # shellcheck disable=SC1090
  source "$_f"
done
unset _f

SWARM_SUBCOMMANDS="open delegate status peek report close watch layout config help _retile-session _resolve _home"

swarm_usage() {
  local s list=""
  for s in $SWARM_SUBCOMMANDS; do
    [[ "$s" == _* ]] || list="${list}${list:+|}$s"
  done
  echo "usage: swarm <$list> [args]"
}

# _help_line <subcommand> -> its synopsis and what it does.
_help_line() {
  case "$1" in
    open)     echo "open [--own-window] <name|group|path>...  open projects' main tabs (also: swarm <name>...)" ;;
    delegate) echo "delegate <name> [--model M] [--layout stack|grid] (--brief-file F | -)  start a lieutenant (main tab only)" ;;
    status)   echo "status [--json] [--all]       swarm tabs, agent states and reports" ;;
    peek)     echo "peek <name|project:name|%pane> [-n lines]  the last lines of an agent's pane" ;;
    report)   echo "report <done|blocked> <text>  set your tab's report (lieutenants only)" ;;
    close)    echo "close <name|project:name>     stop a lieutenant and close its tab" ;;
    watch)    echo "watch [--project P] [--once]  print stalled, idle-unreported and over-cap lieutenants" ;;
    layout)   echo "layout <stack|grid>           switch your lieutenant tab's layout" ;;
    config)   echo "config                        print the parsed config and any errors" ;;
    help)     echo "help                          this list" ;;
  esac
}

cmd_help() {
  local s
  swarm_usage
  echo
  for s in $SWARM_SUBCOMMANDS; do
    [[ "$s" == _* ]] || echo "  $(_help_line "$s")"
  done
}

main() {
  if [[ $# -eq 0 ]]; then
    swarm_usage >&2
    exit 1
  fi
  local sub="$1" s fn
  shift
  if [[ "$sub" == --own-window ]]; then
    cmd_open "$sub" "$@"
    return
  fi
  if [[ "$sub" == -* ]]; then
    swarm_usage >&2
    exit 1
  fi
  for s in $SWARM_SUBCOMMANDS; do
    if [[ "$s" == "$sub" ]]; then
      fn="cmd_${sub//-/_}"
      if declare -F "$fn" >/dev/null; then
        "$fn" "$@"
        return
      fi
      break
    fi
  done
  cmd_open "$sub" "$@"
}

main "$@"
